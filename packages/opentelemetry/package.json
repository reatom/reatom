{
  "name": "@reatom/opentelemetry",
  "type": "module",
  "version": "1000.15.2",
  "description": "Modular browser observability, local debugging, and Reatom tracing",
  "private": false,
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "browserslist": [
    "last 1 year"
  ],
  "scripts": {
    "prepublishOnly": "pnpm run build && pnpm run test",
    "build": "tsdown",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc -p type-tests/tsconfig.json",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:e2e:collector": "node e2e/collector/run.mjs",
    "test:e2e:collector:oracle": "node --test e2e/collector/*.test.mjs",
    "test:e2e:clickhouse": "node e2e/collector/run-clickhouse.mjs",
    "test:e2e:faro": "node e2e/faro/run.mjs",
    "size": "size-limit --config .size-limit.json",
    "test:bundles": "pnpm run build && node tools/check-browser-bundles.mjs",
    "size:example": "node tools/measure-example.mjs"
  },
  "tsdown": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "esm",
      "cjs"
    ],
    "fixedExtension": false,
    "unbundle": true
  },
  "peerDependencies": {
    "@reatom/core": "workspace:^"
  },
  "author": {
    "name": "astartsky",
    "url": "https://github.com/astartsky"
  },
  "maintainers": [
    {
      "name": "artalar",
      "url": "https://github.com/artalar"
    },
    {
      "name": "astartsky",
      "url": "https://github.com/astartsky"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/reatom/reatom.git",
    "directory": "packages/opentelemetry"
  },
  "bugs": {
    "url": "https://github.com/reatom/reatom/issues"
  },
  "homepage": "https://www.reatom.dev/guides/opentelemetry/",
  "keywords": [
    "reactive",
    "reactivity",
    "state-manager",
    "reatom"
  ],
  "files": [
    "/dist"
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "size-limit": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "web-vitals": "6.2.3"
  }
}
