{
  "name": "@reatom/opentelemetry",
  "type": "module",
  "version": "1000.15.2",
  "description": "Modular browser observability, local debugging, and Reatom tracing",
  "private": false,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./gdpr": {
      "types": "./dist/gdpr/index.d.ts",
      "require": "./dist/gdpr/index.cjs",
      "default": "./dist/gdpr/index.js"
    },
    "./web-analytics": {
      "types": "./dist/web-analytics/index.d.ts",
      "require": "./dist/web-analytics/index.cjs",
      "default": "./dist/web-analytics/index.js"
    },
    "./faro": {
      "types": "./dist/faro/index.d.ts",
      "require": "./dist/faro/index.cjs",
      "default": "./dist/faro/index.js"
    },
    "./browser-network": {
      "types": "./dist/browser-network/index.d.ts",
      "require": "./dist/browser-network/index.cjs",
      "default": "./dist/browser-network/index.js"
    },
    "./browser-console": {
      "types": "./dist/browser-console/index.d.ts",
      "require": "./dist/browser-console/index.cjs",
      "default": "./dist/browser-console/index.js"
    },
    "./web-vitals": {
      "types": "./dist/web-vitals/index.d.ts",
      "require": "./dist/web-vitals/index.cjs",
      "default": "./dist/web-vitals/index.js"
    },
    "./browser-performance": {
      "types": "./dist/browser-performance/index.d.ts",
      "require": "./dist/browser-performance/index.cjs",
      "default": "./dist/browser-performance/index.js"
    },
    "./browser-errors": {
      "types": "./dist/browser-errors/index.d.ts",
      "require": "./dist/browser-errors/index.cjs",
      "default": "./dist/browser-errors/index.js"
    },
    "./browser-actions": {
      "types": "./dist/browser-actions/index.d.ts",
      "require": "./dist/browser-actions/index.cjs",
      "default": "./dist/browser-actions/index.js"
    },
    "./browser-csp": {
      "types": "./dist/browser-csp/index.d.ts",
      "require": "./dist/browser-csp/index.cjs",
      "default": "./dist/browser-csp/index.js"
    },
    "./browser-metadata": {
      "types": "./dist/browser-metadata/index.d.ts",
      "require": "./dist/browser-metadata/index.cjs",
      "default": "./dist/browser-metadata/index.js"
    },
    "./faro/client": {
      "types": "./dist/faro/client.d.ts",
      "require": "./dist/faro/client.cjs",
      "default": "./dist/faro/client.js"
    },
    "./attributes": {
      "types": "./dist/attributes/index.d.ts",
      "require": "./dist/attributes/index.cjs",
      "default": "./dist/attributes/index.js"
    },
    "./otlp": {
      "types": "./dist/otlp/index.d.ts",
      "require": "./dist/otlp/index.cjs",
      "default": "./dist/otlp/index.js"
    },
    "./strict-capture": {
      "types": "./dist/strict-capture/index.d.ts",
      "require": "./dist/strict-capture/index.cjs",
      "default": "./dist/strict-capture/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "require": "./dist/browser/index.cjs",
      "default": "./dist/browser/index.js"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "browserslist": [
    "last 1 year"
  ],
  "scripts": {
    "prepublishOnly": "pnpm run build && pnpm run test",
    "build": "tsdown",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc -p type-tests/tsconfig.json",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:e2e:collector": "node e2e/collector/run.mjs",
    "test:e2e:collector:oracle": "node --test e2e/collector/*.test.mjs",
    "test:e2e:clickhouse": "node e2e/collector/run-clickhouse.mjs",
    "test:e2e:faro": "node e2e/faro/run.mjs",
    "size": "size-limit --config .size-limit.json",
    "test:bundles": "pnpm run build && node tools/check-browser-bundles.mjs"
  },
  "tsdown": {
    "entry": [
      "src/index.ts",
      "src/gdpr/index.ts",
      "src/web-analytics/index.ts",
      "src/faro/index.ts",
      "src/browser-network/index.ts",
      "src/browser-console/index.ts",
      "src/web-vitals/index.ts",
      "src/browser-performance/index.ts",
      "src/browser-errors/index.ts",
      "src/browser-actions/index.ts",
      "src/browser-csp/index.ts",
      "src/browser-metadata/index.ts",
      "src/faro/client.ts",
      "src/attributes/index.ts",
      "src/otlp/index.ts",
      "src/strict-capture/index.ts",
      "src/browser/index.ts"
    ],
    "format": [
      "esm",
      "cjs"
    ],
    "fixedExtension": false
  },
  "peerDependencies": {
    "@reatom/core": "workspace:^"
  },
  "author": {
    "name": "astartsky",
    "url": "https://github.com/astartsky"
  },
  "maintainers": [
    {
      "name": "artalar",
      "url": "https://github.com/artalar"
    },
    {
      "name": "astartsky",
      "url": "https://github.com/astartsky"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/reatom/reatom.git",
    "directory": "packages/opentelemetry"
  },
  "bugs": {
    "url": "https://github.com/reatom/reatom/issues"
  },
  "homepage": "https://www.reatom.dev/package/opentelemetry",
  "keywords": [
    "reactive",
    "reactivity",
    "state-manager",
    "reatom"
  ],
  "files": [
    "/dist",
    "/API.md",
    "/MIGRATION.md"
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "size-limit": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "web-vitals": "6.2.3"
  }
}
